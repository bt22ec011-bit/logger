# Copy to .env and adjust as needed.
# Base URL of the logger backend API (Flask app on port 4000).
VITE_LOGGER_API_URL=http://localhost:4000

# Optional: when running `logging_agent.py` in proxy mode, point Vite's
# /api proxy at the AGENT (not directly at the backend) so each request
# is logged exactly once with correct Frontend -> Backend direction.
# Example: agent started with --proxy-port 4100
# VITE_PROXY_TARGET=http://localhost:4100
